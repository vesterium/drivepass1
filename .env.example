# ══════════════════════════════════════════════════════════════
#  ШАБЛОН — скопируй в .env и заполни реальными значениями
#  Реальный .env файл НИКОГДА не загружается в GitHub
# ══════════════════════════════════════════════════════════════

# Supabase (найди в: supabase.com → твой проект → Settings → API)
VITE_SUPABASE_URL=https://ТВОЙ_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=ТВОЙ_ANON_KEY_СЮДА
VITE_SUPABASE_PROJECT_ID=ТВОЙ_PROJECT_ID
